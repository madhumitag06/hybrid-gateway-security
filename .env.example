# ==============================================================================
# Adaptive AI-Powered Security Gateway for Hybrid Cloud
# Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Core & Database Configuration (REQUIRED for full persistence)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Relational Datastore for events, audit logs, rules)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hybrid_gateway_db

# Security Secret Key
SECRET_KEY=adaptive-hybrid-gateway-dev-insecure-secret-key-change-in-prod

# Debug Mode (False in Production)
DEBUG=False

# Allowed CORS Origins for Frontend Integration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI Policy Engine & Enforcement Configuration (OPTIONAL - Defaults to Safe DRY_RUN)
# ------------------------------------------------------------------------------
# Default Gateway Operating Mode:
#   DRY_RUN : Audit simulation only; zero host firewall changes (Default)
#   SANDBOX : In-memory quarantine filter with automatic TTL expiration
DEFAULT_ENFORCEMENT_MODE=DRY_RUN

# Default Containment Rule Expiration (Seconds)
DEFAULT_RULE_TTL_SECONDS=300

# Critical Infrastructure IPs Gated from Automated Blocking (Allowlist)
MANAGEMENT_ALLOWLIST=10.100.0.1,192.168.1.1,127.0.0.1

# ------------------------------------------------------------------------------
# 3. AWS CloudWatch & VPC Flow Log Telemetry (OPTIONAL - Read-Only)
# ------------------------------------------------------------------------------
# Note: AWS integration is strictly READ-ONLY. If credentials are not provided,
# the gateway runs in high-fidelity deterministic offline fixture mode (AWS_FIXTURE).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_VPC_FLOW_LOG_GROUP=

# ------------------------------------------------------------------------------
# 4. Optional Security Analyst AI Copilot (Advisory Executive Briefings)
# ------------------------------------------------------------------------------
# Providers:
#   none   : Deterministic local XAI synthesis (Default, no API key needed)
#   groq   : High-speed Groq Cloud LLM (llama-3.3-70b-versatile)
#   openai : OpenAI API (gpt-4o-mini)
# Note: The AI Copilot is strictly an explanatory advisor. It CANNOT override
# RandomForest threat classification, SHAP attributions, or PolicyEngine rules.
AI_PROVIDER=none
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MODEL=

# ------------------------------------------------------------------------------
# 5. Full Authentication & Identity Management (Phase 13)
# ------------------------------------------------------------------------------
# JWT Session Security
AUTH_JWT_SECRET=hybrid-gateway-production-jwt-signing-key-replace-with-entropy-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Administrator Bootstrap Credentials (PostgreSQL Backed)
ADMIN_EMAIL=admin@gateway.local
ADMIN_PASSWORD=AdminSecOps2026!

# Google OAuth 2.0 / OpenID Connect (Optional - Local auth active by default)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Frontend Client Environment Variables
# ------------------------------------------------------------------------------
# Base API URL (Vite proxy forwards /api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=/api


