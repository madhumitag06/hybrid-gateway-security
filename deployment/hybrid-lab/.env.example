# ==============================================================================
# Adaptive AI-Powered Security Gateway — Virtual Hybrid-Cloud Lab Configuration
# Copy this file to deployment/hybrid-lab/.env before starting the lab:
#   Copy-Item deployment/hybrid-lab/.env.example deployment/hybrid-lab/.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Persistence (Isolated Storage Plane on mgmt_net 10.30.10.5)
# ------------------------------------------------------------------------------
POSTGRES_USER=gateway_lab_user
POSTGRES_PASSWORD=ChangeMe_HybridLabDbPass_2026!
POSTGRES_DB=hybrid_gateway_lab_db

# Full SQLAlchemy psycopg3 URL used by gateway-api inside Docker
DATABASE_URL=postgresql+psycopg://gateway_lab_user:ChangeMe_HybridLabDbPass_2026!@postgres:5432/hybrid_gateway_lab_db

# ------------------------------------------------------------------------------
# 2. Gateway API & Authentication Configuration (Control Plane 10.30.10.10)
# ------------------------------------------------------------------------------
SECRET_KEY=replace-with-high-entropy-lab-secret-key-min-32-chars
AUTH_JWT_SECRET=replace-with-high-entropy-lab-jwt-signing-secret-key-2026
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

ADMIN_EMAIL=test10@gmail.com
ADMIN_PASSWORD=test@123
ADMIN_NAME=SecOps Lab Administrator

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://frontend

# ------------------------------------------------------------------------------
# 3. Hybrid Network Zone Subnets & Virtual Router Configuration
# ------------------------------------------------------------------------------
# On-Premises Private Lab Network: 10.10.10.0/24 (Router IP: 10.10.10.2)
ON_PREM_CIDRS=10.10.10.0/24,192.168.0.0/16,10.0.0.0/16

# Simulated Cloud VPC Lab Network: 10.20.10.0/24 (Router IP: 10.20.10.2)
AWS_VPC_CIDRS=10.20.10.0/24,10.100.0.0/16,172.31.0.0/16

# Simulated AWS Region & Flow Log Account/Interface Identifiers
AWS_REGION=us-east-1
AWS_TELEMETRY_MODE=AWS_FIXTURE
SIMULATED_AWS_ACCOUNT_ID=123456789012
SIMULATED_AWS_ENI_ID=eni-sim0a1b2c3d4e5f01

# ------------------------------------------------------------------------------
# 4. Enforcement & Containment Guardrails
# ------------------------------------------------------------------------------
# Default mode: DRY_RUN or SANDBOX (in-memory quarantine filter)
DEFAULT_ENFORCEMENT_MODE=SANDBOX
DEFAULT_RULE_TTL_SECONDS=300

# Optional isolated lab router iptables synchronization (Default: false / opt-in)
# Set to true to allow SANDBOX decisions to program lab-router's isolated FORWARD chain
LAB_ENFORCEMENT_ENABLED=false
LAB_ROUTER_URL=http://10.30.10.2:8099
LAB_ALLOWED_TARGET_CIDRS=10.10.10.0/24,10.20.10.0/24

# Protected infrastructure IPs that can never be blocked
MANAGEMENT_ALLOWLIST=127.0.0.1/32,10.10.10.1/32,10.10.10.2/32,10.20.10.1/32,10.20.10.2/32,10.30.10.0/24

# ------------------------------------------------------------------------------
# 5. PCAP & SHAP Optimization Settings
# ------------------------------------------------------------------------------
PCAP_MAX_EVALUATED_FLOWS=500
PCAP_MAX_Response_FLOWS=50
SHAP_RISK_THRESHOLD=50
PCAP_DB_BATCH_SIZE=100

# Bounded Capture Limits inside Telemetry Volume
CAPTURE_MAX_PACKETS=2500
CAPTURE_MAX_DURATION_SECONDS=30
CAPTURE_MAX_FILES=20
CAPTURE_MAX_FILE_SIZE_MB=10

# ------------------------------------------------------------------------------
# 6. Optional AI Analyst Copilot (Default: none / Deterministic XAI Synthesis)
# ------------------------------------------------------------------------------
AI_PROVIDER=none
LLM_PROVIDER=none
GROQ_API_KEY=
OPENAI_API_KEY=

