# ==============================================================================
# Adaptive AI-Powered Security Gateway for Hybrid Cloud
# Configuration Template (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Backend Core & Database Configuration (REQUIRED for full persistence)
# ------------------------------------------------------------------------------
# PostgreSQL Connection URL (Relational Datastore for events, audit logs, rules)
DATABASE_URL=postgresql://postgres:postgres@localhost:5434/hybrid_gateway_db

# Application Environment ('development', 'staging', 'production')
# Production mode enforces mandatory high-entropy keys and fails startup if defaults are used.
APP_ENV=development

# Security Secret Key
SECRET_KEY=adaptive-hybrid-gateway-dev-insecure-secret-key-change-in-prod

# Debug Mode (False in Production)
DEBUG=False

# Allowed CORS Origins for Frontend Integration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. AI Policy Engine & Enforcement Configuration (OPTIONAL - Defaults to Safe DRY_RUN)
# ------------------------------------------------------------------------------
# Default Gateway Operating Mode:
#   DRY_RUN : Audit simulation only; zero host firewall changes (Default)
#   SANDBOX : In-memory quarantine filter with automatic TTL expiration
DEFAULT_ENFORCEMENT_MODE=DRY_RUN

# Default Containment Rule Expiration (Seconds)
DEFAULT_RULE_TTL_SECONDS=300

# Critical Infrastructure IPs Gated from Automated Blocking (Allowlist)
MANAGEMENT_ALLOWLIST=10.100.0.1,192.168.1.1,127.0.0.1

# ------------------------------------------------------------------------------
# 3. Multi-Cloud Provider Integration & Telemetry (AWS, GCP, Azure)
# ------------------------------------------------------------------------------
# Note: Cloud integrations are strictly non-mutating / read-only by default.
# The user supplies cloud credentials after initial deployment. If credentials
# are not provided, each provider runs in clear 'NOT_CONFIGURED' or offline fixture mode.

# --- AWS Configuration ---
AWS_ENABLED=false
AWS_AUTH_MODE=assume_role
AWS_ACCOUNT_ID=
AWS_ROLE_ARN=
AWS_EXTERNAL_ID=AdaptiveGatewayAuth
AWS_DEFAULT_REGION=ap-southeast-2
AWS_REGION=us-east-1

# Optional AWS Access-Key Authentication (Fallback)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# Optional CloudWatch VPC Flow Logs
AWS_FLOW_LOG_GROUP=/aws/vpc/flow-logs
AWS_FLOW_LOG_REGION=
AWS_VPC_FLOW_LOG_GROUP=

# --- Google Cloud Platform (GCP - Google Builders Hub) Configuration ---
GCP_ENABLED=false
GCP_AUTH_MODE=workload_identity
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_REGION=us-central1
GCP_WORKLOAD_IDENTITY_PROVIDER=
GCP_SERVICE_ACCOUNT=
# Optional Service Account JSON Path (Fallback)
GCP_SERVICE_ACCOUNT_JSON_PATH=

# --- Microsoft Azure Configuration ---
AZURE_ENABLED=false
AZURE_AUTH_MODE=service_principal
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REGION=eastus

# --- Shared Credential Vault & Secret Encryption ---
# 256-bit (32-byte) hex or base64 key used for AES-256-GCM envelope encryption of cloud credentials at rest.
# In development, auto-derives from app secret; in production, set to a high-entropy 256-bit key.
CLOUD_CREDENTIAL_ENCRYPTION_KEY=
CLOUD_CREDENTIAL_KEY_VERSION=v1
CLOUD_ENFORCEMENT_ENABLED=false

# ------------------------------------------------------------------------------
# 4. Optional Security Analyst AI Copilot (Advisory Executive Briefings)
# ------------------------------------------------------------------------------
# Providers:
#   none   : Deterministic local XAI synthesis (Default, no API key needed)
#   groq   : High-speed Groq Cloud LLM (llama-3.3-70b-versatile)
#   openai : OpenAI API (gpt-4o-mini)
# Note: The AI Copilot is strictly an explanatory advisor. It CANNOT override
# RandomForest threat classification, SHAP attributions, or PolicyEngine rules.
AI_PROVIDER=none
LLM_PROVIDER=none
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_MODEL=

# ------------------------------------------------------------------------------
# 5. Full Authentication & Identity Management (Phase 13)
# ------------------------------------------------------------------------------
# JWT Session Security
AUTH_JWT_SECRET=hybrid-gateway-production-jwt-signing-key-replace-with-entropy-secret
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Inter-Service Machine-to-Machine API Key (Phase 22 Production Hardening)
# Required in production (APP_ENV=production, minimum 32 characters).
# Callers authenticate via HTTP header: X-API-Key: <key> or X-Service-Token: <key>
GATEWAY_SERVICE_KEY=

# Trusted Management Network CIDRs (Phase 22.3 SEC-09 Network Authorization)
# Comma-separated list of IPv4/IPv6 CIDRs authorized for machine-to-machine API access.
# Strictly separated from firewall policy allowlists. Defaults to loopback only.
TRUSTED_MANAGEMENT_NETWORKS=127.0.0.1/32,::1/128

# Initial Administrator Bootstrap Credentials (PostgreSQL Backed)
ADMIN_EMAIL=admin@gateway.local
ADMIN_PASSWORD=AdminSecOps2026!

# Google OAuth 2.0 / OpenID Connect (Optional - Local auth active by default)
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173

# ------------------------------------------------------------------------------
# 6. Frontend Client Environment Variables
# ------------------------------------------------------------------------------
# Base API URL (Vite proxy forwards /api -> http://127.0.0.1:8000)
VITE_API_BASE_URL=/api


